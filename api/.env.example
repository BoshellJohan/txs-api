# Base de datos
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/txs?schema=public

# Servidor
PORT=3000
LOG_LEVEL=info

# Tokens. Generar con: openssl rand -base64 48
JWT_ACCESS=
JWT_REFRESH=
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Enlaces de recuperacion de contrasena
FRONT_URL=http://localhost:4200

# Correo saliente. EMAIL_PASSWORD es una contrasena de aplicacion de Gmail,
# no la contrasena de la cuenta
EMAIL_USER=
EMAIL_PASSWORD=

# Trazas
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=txs-api
